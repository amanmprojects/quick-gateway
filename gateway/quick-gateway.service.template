[Unit]
Description=quick-gateway - LiteLLM proxy bridging OpenCode Zen to OpenAI/Anthropic clients
Documentation=https://github.com/amanmprojects/quick-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
EnvironmentFile=__HOME__/.config/quick-gateway/gateway.env
ExecStart=__HOME__/.local/share/quick-gateway/venv/bin/litellm --config __HOME__/.config/quick-gateway/config.yaml --host 127.0.0.1 --port 4000
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
